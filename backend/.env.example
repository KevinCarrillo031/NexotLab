# NexotLab backend — configuración de entorno
# Copiar este archivo a .env y ajustar valores.

APP_NAME=NexotLab API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# true = conectar a MySQL/MariaDB | false = solo datos en memoria
CONNECT_DATABASE=true

# MySQL/MariaDB (phpMyAdmin en localhost)
# Formato: mysql+pymysql://usuario:contraseña@host:puerto/basededatos
DATABASE_URL=mysql+pymysql://root:@localhost:3306/proyectodecimo

# Umbrales de evaluación semanal
HIGH_SCORE_THRESHOLD=4.0
LOW_SCORE_THRESHOLD=2.5

RANDOM_SEED=42
CORS_ORIGINS=http://localhost:5173,http://localhost:8443,http://127.0.0.1:5173
